# CircuitMind Design Co-pilot — Configuration Template
# Copy this file to .env and fill in your own values.
# Never commit the real .env file to git.

# ── NVIDIA / OpenAI-compatible API ─────────────────────────
# Get your key from https://integrate.api.nvidia.com
OPENAI_API_KEY=nvapi-YOUR_KEY_HERE

# Model to use (NVIDIA Nemotron-3 or any OpenAI-compatible model)
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Base URL for the NVIDIA Integrate API
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Optional: PostgreSQL (leave defaults if using SQLite fallback) ──
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/circuitmind

# ── Optional: Qdrant (leave :memory: for in-memory, or use Docker host) ──
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
